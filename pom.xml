<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.3</version>
    <relativePath/>
  </parent>

  <groupId>com.sneakycook</groupId>
  <artifactId>recipe-api-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Recipe API</name>
  <description>REST API for managing and filtering favourite recipes</description>

  <modules>
    <module>domain</module>
    <module>application</module>
    <module>infrastructure</module>
    <module>api</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <openapi-generator.version>7.13.0</openapi-generator.version>
    <swagger-ui.version>5.17.14</swagger-ui.version>
    <!-- TDD red suite: tests for not-yet-implemented features are excluded from
         the default build and run with -Pe2e-all (spec §7). -->
    <surefire.excluded.groups>red</surefire.excluded.groups>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <excludedGroups>${surefire.excluded.groups}</excludedGroups>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Runs the full suite including red-tagged E2E tests: mvn -Pe2e-all test -->
    <profile>
      <id>e2e-all</id>
      <properties>
        <surefire.excluded.groups/>
      </properties>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.sneakycook</groupId>
        <artifactId>recipe-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sneakycook</groupId>
        <artifactId>recipe-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sneakycook</groupId>
        <artifactId>recipe-infrastructure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webjars</groupId>
        <artifactId>swagger-ui</artifactId>
        <version>${swagger-ui.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
