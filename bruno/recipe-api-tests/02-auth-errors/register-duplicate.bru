meta {
  name: [REQ-17] Duplicate username → 409 problem document
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{userA}}",
    "password": "{{password}}"
  }
}

tests {
  test("409 conflict naming the username", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().status).to.equal(409);
    expect(res.getBody().title).to.equal("Conflict");
    expect(res.getBody().detail).to.equal("Username '" + bru.getVar("userA") + "' is already taken");
    expect(res.getBody().instance).to.equal("/api/v1/auth/register");
  });
}
