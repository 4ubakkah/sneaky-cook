meta {
  name: [REQ-17] Wrong password → 401 problem document
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{userA}}",
    "password": "not-the-password"
  }
}

tests {
  test("401 with the generic credentials detail", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().title).to.equal("Unauthorized");
    expect(res.getBody().detail).to.equal("Invalid username or password");
  });
}
