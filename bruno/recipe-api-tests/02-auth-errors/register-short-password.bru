meta {
  name: [REQ-17] Password below 8 chars → 400 with field error
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{userA}}-short",
    "password": "short"
  }
}

tests {
  test("400 with a 'password' field error", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().status).to.equal(400);
    const fields = res.getBody().errors.map(e => e.field);
    expect(fields).to.include("password");
  });
}
