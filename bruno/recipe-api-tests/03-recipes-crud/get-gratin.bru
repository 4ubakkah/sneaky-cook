meta {
  name: [REQ-4] Fetch by id → 200 identical payload
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/recipes/{{gratinId}}
  body: none
  auth: inherit
}

tests {
  test("200 with the identical stored recipe", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.id).to.equal(bru.getVar("gratinId"));
    expect(body.name).to.equal("Potato gratin");
    expect(body.vegetarian).to.equal(true);
    expect(body.servings).to.equal(4);
    expect(body.ingredients).to.deep.equal(["potatoes", "cream", "cheese", "garlic"]);
    expect(body.createdAt).to.equal(bru.getVar("gratinCreatedAt"));
  });
}
