meta {
  name: [REQ-4] size above the hard cap of 100 → 400
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/recipes?size=101
  body: none
  auth: inherit
}

tests {
  test("400 problem document", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().status).to.equal(400);
  });
}
