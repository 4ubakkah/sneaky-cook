meta {
  name: [REQ-18] B's list is empty — totals are per-owner
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/recipes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenB}}
}

tests {
  test("no leakage across users", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().totalElements).to.equal(0);
    expect(res.getBody().totalPages).to.equal(0);
    expect(res.getBody().content).to.deep.equal([]);
  });
}
