meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

docs {
  Creates the account this collection runs as. Re-running returns
  409 "Username ... is already taken" — that is fine, continue with Login.
}
